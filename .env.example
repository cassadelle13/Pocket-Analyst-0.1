# PocketAnalyst Environment Variables

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Jitsu
JITSU_HOST=localhost
JITSU_PORT=8000
JITSU_WRITE_KEY=your_jitsu_write_key

# Dify
DIFY_API_URL=http://localhost:5001
DIFY_API_KEY=your_dify_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_JITSU_HOST=http://localhost:8000
NEXT_PUBLIC_JITSU_WRITE_KEY=your_jitsu_write_key
