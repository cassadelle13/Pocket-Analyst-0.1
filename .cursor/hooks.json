{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/before-shell.py",
        "timeout": 8,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/before-read.py",
        "timeout": 8,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/after-edit.py",
        "timeout": 25
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/stop.py",
        "timeout": 20,
        "loop_limit": 2
      }
    ]
  }
}
